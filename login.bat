@echo off
chcp 65001 >nul
title تسجيل الدخول بحساب أبل - ipatool
color 0b
echo ========================================================
echo       تسجيل الدخول التفاعلي إلى متجر أبل (Apple ID)
echo ========================================================
echo.
echo  الخطوات:
echo   1. اكتب بريد أبل (Apple ID) ثم اضغط Enter
echo   2. اكتب كلمة المرور ثم اضغط Enter (لن تظهر الحروف للحماية)
echo   3. اكتب كود التحقق بخطوتين (2FA) الواصل للايفون
echo   4. اكتب الباسورد السريع للحافظة (مثل 2211) لحفظ الجلسة
echo.
echo ========================================================
echo.
if exist "%~dp0ipatool.exe" (
    "%~dp0ipatool.exe" auth login
) else if exist "%~dp0ipatoo.exe" (
    "%~dp0ipatoo.exe" auth login
) else (
    ipatool auth login
)
echo.
echo ========================================================
echo تم الانتهاء! يمكنك إغلاق هذه النافذة والعودة إلى التطبيق.
echo ========================================================
pause
